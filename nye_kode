<?php
mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);

try {
    $conn = new mysqli(
        "localhost",
        "root",
        "",
        "fazbear_entertainment"
    );

    $conn->set_charset("utf8mb4");

    $selectedName = $_GET["name"] ?? "";
    $selectedCategory = $_GET["category"] ?? "";

    $sql = "
        SELECT animatronic_name AS name, 'Animatronic' AS category
        FROM animatronics

        UNION ALL

        SELECT incident_name AS name, 'Incident' AS category
        FROM incidents

        UNION ALL

        SELECT location_name AS name, 'Location' AS category
        FROM locations

        ORDER BY category, name
    ";

$result = $conn->query($sql);
$items = $result->fetch_all(MYSQLI_ASSOC);

$relatedItems = [];

if ($selectedName != "") {

    if ($selectedCategory == "Animatronic") {

        $sql = "
            SELECT DISTINCT
                i.incident_name AS name,
                'Incident' AS category
            FROM animatronics a
            JOIN animatronic_incidents ai
                ON a.animatronic_id = ai.animatronic_id
            JOIN incidents i
                ON ai.incident_id = i.incident_id
            WHERE a.animatronic_name = ?

            UNION

            SELECT DISTINCT
                l.location_name AS name,
                'Location' AS category
            FROM animatronics a
            JOIN animatronic_incidents ai
                ON a.animatronic_id = ai.animatronic_id
            JOIN incidents i
                ON ai.incident_id = i.incident_id
            JOIN incident_locations il
                ON i.incident_id = il.incident_id
            JOIN locations l
                ON il.location_id = l.location_id
            WHERE a.animatronic_name = ?
        ";

        $stmt = $conn->prepare($sql);
        $stmt->bind_param("ss", $selectedName, $selectedName);

    } elseif ($selectedCategory == "Incident") {

        $sql = "
            SELECT DISTINCT
                a.animatronic_name AS name,
                'Animatronic' AS category
            FROM incidents i
            JOIN animatronic_incidents ai
                ON i.incident_id = ai.incident_id
            JOIN animatronics a
                ON ai.animatronic_id = a.animatronic_id
            WHERE i.incident_name = ?

            UNION

            SELECT DISTINCT
                l.location_name AS name,
                'Location' AS category
            FROM incidents i
            JOIN incident_locations il
                ON i.incident_id = il.incident_id
            JOIN locations l
                ON il.location_id = l.location_id
            WHERE i.incident_name = ?
        ";

        $stmt = $conn->prepare($sql);
        $stmt->bind_param("ss", $selectedName, $selectedName);

    } elseif ($selectedCategory == "Location") {

        $sql = "
            SELECT DISTINCT
                i.incident_name AS name,
                'Incident' AS category
            FROM locations l
            JOIN incident_locations il
                ON l.location_id = il.location_id
            JOIN incidents i
                ON il.incident_id = i.incident_id
            WHERE l.location_name = ?

            UNION

            SELECT DISTINCT
                a.animatronic_name AS name,
                'Animatronic' AS category
            FROM locations l
            JOIN incident_locations il
                ON l.location_id = il.location_id
            JOIN incidents i
                ON il.incident_id = i.incident_id
            JOIN animatronic_incidents ai
                ON i.incident_id = ai.incident_id
            JOIN animatronics a
                ON ai.animatronic_id = a.animatronic_id
            WHERE l.location_name = ?
        ";

        $stmt = $conn->prepare($sql);
        $stmt->bind_param("ss", $selectedName, $selectedName);
    }

    $stmt->execute();
    $relatedItems = $stmt->get_result()->fetch_all(MYSQLI_ASSOC);
    $stmt->close();
}

$conn->close();
} catch (mysqli_sql_exception $error) {
    error_log($error->getMessage());
    http_response_code(500);
    exit("Unable to load data. Check your database connection and tables.");
}

function escapeHtml($value) {
    return htmlspecialchars(
        (string) $value,
        ENT_QUOTES | ENT_SUBSTITUTE,
        "UTF-8"
    );
}
